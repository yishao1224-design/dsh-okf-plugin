{
  "name": "@local/dsh-okf",
  "version": "0.1.0",
  "private": true,
  "description": "DeepSeek Harness plugin for OKF knowledge bundles: fetch from git / Azure DevOps, preview, attach a bundle to a chat session, and manage a team's project wikis from the Team Wiki sidebar page",
  "type": "module",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/check-pr.js",
    "examples/wiki-auto-merge.yml",
    "examples/wiki-auto-complete-ado.yml",
    "examples/wiki-publish-to-ado.yml",
    "templates/hub",
    "cordis.patch.yml",
    "README.md"
  ],
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc --noEmit",
    "smoke": "node scripts/smoke.mjs && node scripts/team-smoke.mjs && node scripts/hub-smoke.mjs && node scripts/ado-smoke.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "react-dom": "^18.3.1",
    "react": "^18.3.1",
    "tsdown": "^0.22.2",
    "typescript": "^5.6.3"
  },
  "license": "MIT"
}
